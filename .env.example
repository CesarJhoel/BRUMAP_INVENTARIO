# Ejecuta sh scripts/setup.sh para generar los secretos automáticamente.
SESSION_SECRET=
BOOTSTRAP_PASSWORD=
PROTECTED_SUPERVISOR_USERNAME=supervisor
HOST_PORT=3000
BIND_ADDRESS=127.0.0.1
# Activa ambos cuando publiques detrás de un proxy HTTPS de confianza.
COOKIE_SECURE=0
TRUST_PROXY=0
AUDIT_ENABLED=1
AUDIT_LEVEL=minimal
AUDIT_RETENTION_DAYS=90
AUDIT_MAX_ROWS=8000
